# Local server-side debugging configuration.
# Fill the key here. Do not use a VITE_ prefix for credentials.
# Used by the loopback parser/chat proxy; never bundled in the extension.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# For an optional standalone extension using this local proxy, explicitly add its origin.
# CARDYBARA_EXTENSION_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
