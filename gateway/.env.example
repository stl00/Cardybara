# gateway/.env for `wrangler dev --env local` with Plaid Sandbox (PLAID_PLAN.md). Build it with
#   cd gateway && plaid keys write --env sandbox --gitignore
# which fills the three PLAID_ values below and keeps PROVIDER_KEY. Wrangler reads .env only when gateway/.dev.vars does not
# exist, so use one or the other. Never put a real key in this example file.
PROVIDER_KEY=synthetic-provider-key-not-real
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
